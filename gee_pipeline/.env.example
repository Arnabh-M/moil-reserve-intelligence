# Google Earth Engine Configuration
# ==================================
# 1. Interactive OAuth Flow:
#    Run `earthengine authenticate` in your terminal, and set EE_PROJECT to your registered GCP project ID.
EE_PROJECT=your-gcp-project-id

# 2. Service Account Authentication (Optional for CI/automated runs):
#    Set EE_SERVICE_ACCOUNT_JSON to the absolute or relative path of your service account key file.
# EE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json
