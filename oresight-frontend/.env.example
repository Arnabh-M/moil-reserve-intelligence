# Base URL of the OreSight FastAPI backend, e.g. https://api.example.com (no
# trailing slash). Inlined at BUILD time by Vite, so on Vercel it must be set
# before the build runs. Unset, the client falls back to http://localhost:8000.
VITE_API_BASE_URL=
# false (the default) talks to the live backend above. Set to true only as
# an offline/venue-wifi fallback when the backend isn't reachable.
VITE_USE_MOCK=
