# Copy this file to `.env` and adjust values for your local setup.
# All variables have sane defaults in app/config.py that match docker-compose.yml,
# so a plain `cp .env.example .env` works out of the box for local dev.

# App environment: "dev" or "prod". Only affects log verbosity / behaviour toggles.
APP_ENV=dev

# SQLAlchemy connection string for PostgreSQL + PostGIS.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Matches the `postgres` service credentials in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://oresight:oresight@localhost:5432/oresight

# Neo4j Bolt connection details. Match the `neo4j` service in docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=oresight123

# JSON array of allowed CORS origins for the frontend dev servers.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
