{
  "openapi": "3.1.0",
  "info": {
    "title": "OreSight API",
    "description": "Backend API for OreSight - a mine reserve intelligence prototype built for SIH26009 (MOIL manganese mining).",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/sites": {
      "get": {
        "tags": [
          "sites"
        ],
        "summary": "List all mine sites",
        "description": "Return every mine site with its live active-risk count and average\nreserve confidence.",
        "operationId": "list_sites_sites_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SiteOut"
                  },
                  "type": "array",
                  "title": "Response List Sites Sites Get"
                }
              }
            }
          }
        }
      }
    },
    "/sites/geojson": {
      "get": {
        "tags": [
          "sites"
        ],
        "summary": "Get all sites' boundaries as GeoJSON",
        "description": "Return every site's boundary polygon as a single GeoJSON\nFeatureCollection, ready for direct use as a MapLibre GeoJSON source.\n\nRegistered ahead of `/{site_id}` so the literal path `geojson` is never\nswallowed by the `site_id: int` path converter.",
        "operationId": "list_sites_geojson_sites_geojson_get",
        "responses": {
          "200": {
            "description": "A GeoJSON FeatureCollection with one Feature per site polygon",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response List Sites Geojson Sites Geojson Get"
                }
              }
            }
          }
        }
      }
    },
    "/sites/{site_id}": {
      "get": {
        "tags": [
          "sites"
        ],
        "summary": "Get a single mine site",
        "description": "Return one mine site by id, or 404 if it doesn't exist.",
        "operationId": "get_site_sites__site_id__get",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sites/{site_id}/geojson": {
      "get": {
        "tags": [
          "sites"
        ],
        "summary": "Get a site's boundary as GeoJSON",
        "description": "Return the site's boundary polygon as a GeoJSON FeatureCollection, ready\nfor direct use as a MapLibre GeoJSON source.",
        "operationId": "get_site_geojson_sites__site_id__geojson_get",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A GeoJSON FeatureCollection with a single Feature for the site polygon",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Site Geojson Sites  Site Id  Geojson Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/equipment": {
      "get": {
        "tags": [
          "equipment"
        ],
        "summary": "List equipment",
        "description": "Return equipment, optionally filtered to a single site.",
        "operationId": "list_equipment_equipment_get",
        "parameters": [
          {
            "name": "site_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter to one site's equipment",
              "title": "Site Id"
            },
            "description": "Filter to one site's equipment"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EquipmentOut"
                  },
                  "title": "Response List Equipment Equipment Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/equipment/{equipment_id}/status": {
      "post": {
        "tags": [
          "equipment"
        ],
        "summary": "Update an equipment's status",
        "description": "Update an equipment's status and reason. Transitioning it from 'up' to\n'down' also opens a high-severity `equipment_failure` risk event for its\nsite \u2014 re-posting 'down' while it's already down (e.g. just to update the\nreason text) does not open a second one.",
        "operationId": "update_equipment_status_equipment__equipment_id__status_post",
        "parameters": [
          {
            "name": "equipment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Equipment Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EquipmentStatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquipmentOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/production": {
      "get": {
        "tags": [
          "production"
        ],
        "summary": "List production records",
        "description": "Return production records from the last `days` days, ordered oldest to\nnewest. If fewer than `days` days of history exist (for the site, or at\nall), returns whatever is available rather than erroring or padding.",
        "operationId": "list_production_records_production_get",
        "parameters": [
          {
            "name": "site_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter to one site",
              "title": "Site Id"
            },
            "description": "Filter to one site"
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 365,
              "minimum": 1,
              "description": "How many trailing days to include",
              "default": 30,
              "title": "Days"
            },
            "description": "How many trailing days to include"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductionRecordOut"
                  },
                  "title": "Response List Production Records Production Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "production"
        ],
        "summary": "Record a day's production",
        "description": "Insert a new production record. Returns 409 if one already exists for\nthis site and date.",
        "operationId": "create_production_record_production_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductionRecordCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductionRecordOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/risk-events": {
      "get": {
        "tags": [
          "risk-events"
        ],
        "summary": "List risk events",
        "description": "Return risk events, newest first, optionally filtered by site and/or\nresolved status.",
        "operationId": "list_risk_events_risk_events_get",
        "parameters": [
          {
            "name": "site_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter to one site",
              "title": "Site Id"
            },
            "description": "Filter to one site"
          },
          {
            "name": "resolved",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by resolved status",
              "title": "Resolved"
            },
            "description": "Filter by resolved status"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RiskEventOut"
                  },
                  "title": "Response List Risk Events Risk Events Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/risk-events/{risk_event_id}/causal-graph": {
      "get": {
        "tags": [
          "risk-events"
        ],
        "summary": "Get the causal graph behind a risk event",
        "description": "Return the causal chain that led to this risk event.\n\nSTUB: replaced on Day 3 with a live Neo4j traversal. For now returns a\nfixed, realistically-shaped 5-node chain so the frontend can build the\nReact Flow graph view today.",
        "operationId": "get_causal_graph_risk_events__risk_event_id__causal_graph_get",
        "parameters": [
          {
            "name": "risk_event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Risk Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CausalGraphOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reserve-zones": {
      "get": {
        "tags": [
          "reserve-zones"
        ],
        "summary": "Get reserve zones as GeoJSON",
        "description": "Return reserve zone polygons as a GeoJSON FeatureCollection. Each\nfeature's `confidence_score` property drives the frontend's map colour\nramp.",
        "operationId": "list_reserve_zones_reserve_zones_get",
        "parameters": [
          {
            "name": "site_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter to one site's zones",
              "title": "Site Id"
            },
            "description": "Filter to one site's zones"
          }
        ],
        "responses": {
          "200": {
            "description": "A GeoJSON FeatureCollection of reserve zone polygons",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response List Reserve Zones Reserve Zones Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/recommendations": {
      "get": {
        "tags": [
          "recommendations"
        ],
        "summary": "Get mitigation recommendations for a risk event",
        "description": "Return mitigation options for a risk event.\n\nSTUB: replaced on Day 4 with real recommendation-engine output. For now\nreturns 2 hand-authored recommendations referencing the actual\nsite/equipment behind the given risk event, so the frontend can build the\nrecommendations UI today.",
        "operationId": "get_recommendations_recommendations_get",
        "parameters": [
          {
            "name": "risk_event_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "The risk event to generate recommendations for",
              "title": "Risk Event Id"
            },
            "description": "The risk event to generate recommendations for"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecommendationOut"
                  },
                  "title": "Response Get Recommendations Recommendations Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/simulate": {
      "post": {
        "tags": [
          "simulation"
        ],
        "summary": "Run a what-if scenario simulation",
        "description": "Simulate the impact of a disruption scenario on one site's twin state.\n\nSTUB: replaced on Day 4-5 with the real simulation engine. For now applies\na small deterministic model: the 'before' snapshot is grounded in today's\nreal data for the site, then perturbed by `scenario_type` and\n`duration_days` for 'after' - so the numbers are plausible, move in the\ncorrect direction, and scale with duration rather than being random or\nconstant.",
        "operationId": "simulate_simulate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/kpi/summary": {
      "get": {
        "tags": [
          "kpi"
        ],
        "summary": "Get Command Center KPI summary",
        "description": "Return the 4 headline KPIs for the Command Center dashboard: active\nrisk events, average reserve confidence, sites currently under watch\n(i.e. with at least one active risk), and when the twin state was last\nupdated.",
        "operationId": "get_kpi_summary_kpi_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KPISummaryOut"
                }
              }
            }
          }
        }
      }
    },
    "/admin/jobs": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List background scheduler jobs and their status",
        "description": "Return each registered scheduler job's id, next run time, and last run\nstatus \u2014 proof the ingestion scheduler is alive during the demo.",
        "operationId": "list_jobs_admin_jobs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/JobStatusOut"
                  },
                  "type": "array",
                  "title": "Response List Jobs Admin Jobs Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CausalGraphOut": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/GraphNode"
            },
            "type": "array",
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/GraphEdge"
            },
            "type": "array",
            "title": "Edges"
          }
        },
        "type": "object",
        "required": [
          "nodes",
          "edges"
        ],
        "title": "CausalGraphOut",
        "example": {
          "edges": [
            {
              "relationship": "DELAYS",
              "source": "weather_2026_03_14",
              "target": "blast_plan_b204"
            },
            {
              "relationship": "AFFECTS",
              "source": "blast_plan_b204",
              "target": "zone_b2"
            },
            {
              "relationship": "OPERATES_IN",
              "source": "equipment_ex201",
              "target": "zone_b2"
            },
            {
              "relationship": "CAUSES",
              "source": "zone_b2",
              "target": "risk_event_shortfall"
            }
          ],
          "nodes": [
            {
              "id": "weather_2026_03_14",
              "label": "Heavy Rainfall 14 Mar",
              "type": "WeatherEvent"
            },
            {
              "id": "blast_plan_b204",
              "label": "Blast Plan B-204",
              "type": "BlastPlan"
            },
            {
              "id": "zone_b2",
              "label": "Zone B2",
              "type": "OreZone"
            },
            {
              "id": "equipment_ex201",
              "label": "Excavator EX-201",
              "type": "Equipment"
            },
            {
              "id": "risk_event_shortfall",
              "label": "Production shortfall risk",
              "type": "RiskEvent"
            }
          ]
        }
      },
      "EquipmentOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "site_id": {
            "type": "integer",
            "title": "Site Id"
          },
          "site_name": {
            "type": "string",
            "title": "Site Name"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "equipment_type": {
            "type": "string",
            "title": "Equipment Type"
          },
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Status"
          },
          "last_status_change": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Status Change"
          },
          "status_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Reason"
          }
        },
        "type": "object",
        "required": [
          "id",
          "site_id",
          "site_name",
          "name",
          "equipment_type",
          "status",
          "last_status_change",
          "status_reason"
        ],
        "title": "EquipmentOut",
        "example": {
          "equipment_type": "Excavator",
          "id": 16,
          "last_status_change": "2026-08-30T05:11:27.578760+00:00",
          "name": "Excavator BAL-1",
          "site_id": 1,
          "site_name": "Balaghat",
          "status": "down",
          "status_reason": "Hydraulic pump failure - spare part on order, ETA 3 days"
        }
      },
      "EquipmentStatusUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "EquipmentStatusUpdate",
        "example": {
          "reason": "Engine overheating - pulled for inspection",
          "status": "down"
        }
      },
      "GraphEdge": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "relationship": {
            "type": "string",
            "title": "Relationship"
          }
        },
        "type": "object",
        "required": [
          "source",
          "target",
          "relationship"
        ],
        "title": "GraphEdge"
      },
      "GraphNode": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "type"
        ],
        "title": "GraphNode"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobStatusOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "next_run_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Run Time"
          },
          "last_run_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Run At"
          },
          "last_status": {
            "type": "string",
            "title": "Last Status"
          },
          "last_error": {
            "anyOf": [
              {
