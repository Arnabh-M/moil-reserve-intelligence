# Stage 1: get the precompiled pgvector extension
# Pinned to linux/amd64: postgis/postgis:16-3.4 is amd64-only, so on Apple Silicon (arm64)
# hosts Docker would otherwise pull an arm64-native pgvector build, causing an ELF architecture mismatch.
FROM --platform=linux/amd64 pgvector/pgvector:pg16 AS pgvector_src

# Stage 2: keep PostGIS as the main database image
FROM --platform=linux/amd64 postgis/postgis:16-3.4

COPY --from=pgvector_src /usr/lib/postgresql/16/lib/vector.so /usr/lib/postgresql/16/lib/vector.so
COPY --from=pgvector_src /usr/share/postgresql/16/extension/vector* /usr/share/postgresql/16/extension/

